APP_NAME="Scarlet Overlay"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://scarlet.example.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

OCTANE_SERVER=frankenphp

REVERB_APP_ID=scarlet
REVERB_APP_KEY=scarlet-key
REVERB_APP_SECRET=scarlet-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_PUBLIC_HOST=scarlet.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

VITE_APP_NAME="${APP_NAME}"

PROMETHEUS_URL=http://prometheus:9090
METRICS_PUSH_INTERVAL=15

OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_PHP_EXCLUDED_URLS="pulse,telescope/.*,horizon/.*,api/v1/ping,_ignition/.*,_debugbar/.*"
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
